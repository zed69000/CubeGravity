# Clé d'envoi Google Play (upload key). Copier ce fichier en keystore.properties et le remplir.
# keystore.properties et le fichier .jks ne doivent jamais être commités (ils sont dans .gitignore).
# Garder une copie des deux en lieu sûr : sans elle, il faut demander à Google de réinitialiser la clé.
storeFile=date-gravity-upload.jks
storePassword=
keyAlias=upload
keyPassword=
