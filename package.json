{
  "name": "date-gravity",
  "version": "1.2.12",
  "private": true,
  "description": "Date Gravity : le jeu web, emballé en application iOS / Android avec Capacitor.",
  "scripts": {
    "kit": "node -e \"const b=process.env.GAME_KIT_BASE||'https://games-catalog.sebastienalzamora.workers.dev/kit/';fetch(b+'sync.mjs').then(r=>{if(!r.ok)throw new Error('kit: sync.mjs HTTP '+r.status);return r.text()}).then(t=>import('data:text/javascript,'+encodeURIComponent(t))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "kit:check": "node -e \"const b=process.env.GAME_KIT_BASE||'https://games-catalog.sebastienalzamora.workers.dev/kit/';fetch(b+'sync.mjs').then(r=>{if(!r.ok)throw new Error('kit: sync.mjs HTTP '+r.status);return r.text()}).then(t=>import('data:text/javascript,'+encodeURIComponent(t))).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "build:web": "node tools/app/copy-web.mjs",
    "native:ios": "node tools/app/configure-native.mjs ios",
    "native:android": "node tools/app/configure-native.mjs android",
    "release:android": "node tools/app/release-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/native-purchases": "^8.9.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
